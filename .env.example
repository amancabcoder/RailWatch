# App server
PORT=5000
NODE_ENV=development
# Set to your deployed frontend origin in production; local Vite origin is allowed for development.
APP_ORIGIN=http://localhost:5173

# TinyFish integration (optional)
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_AGENT_URL=https://agent.tinyfish.ai/v1/automation/run-sse
USE_MOCK_FALLBACK=true

# Railway employee login. Choose a unique ID and strong password privately.
# No employee credentials are hard-coded in the application.
RAIL_EMPLOYEE_ID=
RAIL_EMPLOYEE_PASSWORD=

# Citizen phone verification: configure Twilio credentials to send SMS OTPs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Local development only: logs OTPs to the backend terminal. Never enable in production.
ALLOW_DEV_OTP=false

# Historical satellite imagery via Copernicus Data Space Ecosystem (Sentinel-2 L2A).
# Create an OAuth client-credentials application in your Copernicus Data Space account.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
